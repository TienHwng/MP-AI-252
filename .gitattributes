# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf

# Explicitly declare text files you want to always be normalized and converted to CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.pdf binary

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

*.gif binary
