# --- Global .gitignore ---

# ===================== Operating System specific =====================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# ===================== IDE / Editor Configuration =====================
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# ===================== Python =====================
# Virtual environments
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
*.egg-info/
dist/
build/
eggs/
.eggs/
*.egg

# ===================== Node.js / Frontend =====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.yarn/cache/
.eslintcache
.next/
out/

# ===================== PlatformIO =====================
.pio/

# ===================== Logs & Temporary Files =====================
*.log
temp/
tmp/
.env
.env/
.env.*
!.env.example
.env.local
.env.*.local

# ===================== LaTeX Build Artifacts =====================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz
*.run.xml

# ===================== IDE-specific =====================
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/settings.json
.vscode/extensions.json

# ===================== Project-specific =====================
# Tensorflow/Keras models
*.h5
*.keras
*.tflite
*.pb

# Database files
*.db
*.sqlite

# ===================== Docs Folder Rules =====================
# Ignore all files in docs/ folder
docs/**
# But allow directories to be traversed
!docs/*/
# Allow markdown and PDF files
!docs/**/*.md
!docs/**/*.pdf
*.sqlite3

# Repository-specific
docs/report/
.ruff_cache/
