# HERA Bot Configuration
# Copy this to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=8452424681:AAEtG3OeO1KP48OwC_zG0b8QapaeX1htmzU

# OpenRouter API Key (get from https://openrouter.ai/keys)
# Leave empty to use only Ollama
OPENROUTER_API_KEY=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

# MQTT Broker Settings
MQTT_BROKER=localhost
MQTT_PORT=1883

# LLM Model Configuration
OLLAMA_MODEL=qwen2.5:7b

# Budget OpenRouter Models (all under $0.50/1M tokens):
# qwen/qwen-2.5-7b-instruct      - $0.20/1M tokens (recommended)
# meta-llama/llama-3.2-3b        - $0.06/1M tokens (ultra cheap)  
# microsoft/phi-3-medium         - $0.14/1M tokens (good balance)
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# Optional provider lock: ollama | openrouter
# Leave empty for interactive selection at startup
LLM_PROVIDER=

# ------------------ Router + Specialist model map ------------------
# Orchestrator router model
ORCHESTRATOR_MODEL_OLLAMA=qwen2.5:1.5b
ORCHESTRATOR_MODEL_OPENROUTER=qwen/qwen-2.5-7b-instruct

# Specialist agent models (Ollama)
DEVICE_AGENT_MODEL_OLLAMA=qwen2.5:7b
SENSOR_AGENT_MODEL_OLLAMA=qwen2.5:7b
ANOMALY_AGENT_MODEL_OLLAMA=qwen2.5:7b
CHAT_AGENT_MODEL_OLLAMA=qwen2.5:7b

# Specialist agent models (OpenRouter)
DEVICE_AGENT_MODEL_OPENROUTER=qwen/qwen-2.5-7b-instruct
SENSOR_AGENT_MODEL_OPENROUTER=qwen/qwen-2.5-7b-instruct
ANOMALY_AGENT_MODEL_OPENROUTER=qwen/qwen-2.5-7b-instruct
CHAT_AGENT_MODEL_OPENROUTER=qwen/qwen-2.5-7b-instruct

# ------------------ MQTT topics ------------------
TOPIC_TELEMETRY=v1/devices/me/telemetry
TOPIC_RPC_REQUEST=v1/devices/me/rpc/request/
TOPIC_RPC_RESPONSE=v1/devices/me/rpc/response/
TOPIC_ATTRIBUTES=v1/devices/me/attributes

# ------------------ AI thresholds ------------------
NORMAL_TEMP_MIN=25
NORMAL_TEMP_MAX=35
NORMAL_HUMI_MIN=60
NORMAL_HUMI_MAX=80
ANOMALY_THRESHOLD=0.5
ANOMALY_CRITICAL_THRESHOLD=0.8

# ------------------ Runtime limits ------------------
MAX_TOOL_ITERATIONS=5
MAX_HISTORY=8

# ------------------ Telegram timeouts (seconds) ------------------
TELEGRAM_READ_TIMEOUT=30
TELEGRAM_WRITE_TIMEOUT=30
TELEGRAM_CONNECT_TIMEOUT=30

# ------------------ Simulator controls ------------------
SIM_TELEMETRY_INTERVAL=5
SIM_TEMP_MIN=15
SIM_TEMP_MAX=45
SIM_HUMI_MIN=30
SIM_HUMI_MAX=95